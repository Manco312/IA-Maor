# ── Credencial del núcleo ────────────────────────────────────────────────────
# Clave de la API de Claude (https://console.anthropic.com/).
# Copia este archivo como .env y pega tu clave. NUNCA subas .env a ningún sitio.
ANTHROPIC_API_KEY=sk-ant-...

# ── Ajustes opcionales ───────────────────────────────────────────────────────
# Puerto del servidor local
PORT=3000

# Modelo. Por defecto claude-opus-5-5 (el más capaz para sostener el personaje).
# Alternativa más barata y rápida: claude-sonnet-5-5
MISAIAL_MODELO=claude-opus-5-5

# Profundidad de razonamiento: low | medium | high | xhigh | max
# "low" mantiene la conversación ágil; súbelo si quieres respuestas más densas.
MISAIAL_ESFUERZO=low

# Longitud máxima de cada respuesta
MISAIAL_MAX_TOKENS=4000
